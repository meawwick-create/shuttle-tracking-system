# ระบบติดตามรถรับ-ส่ง - Environment Variables Template
# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง
# copy .env.example .env

# ==============================
# Supabase Configuration
# ==============================
# ดูค่าได้ที่: Supabase Dashboard -> Project Settings -> API

# Project URL (เช่น https://abcdefgh.supabase.co)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Anon Public Key (ใช้ anon/public key เท่านั้น ห้ามใช้ service_role key!)
VITE_SUPABASE_KEY=sb_publishable_YOUR_ANON_KEY_HERE
